    return (
      <div className={`inline-flex items-center gap-2.5 select-none ${className}`}>
        <img
          src="/logo-icon.png"
          alt="Dispatch"
          style={{ width: size, height: size }}
          className="object-contain drop-shadow-sm flex-shrink-0"
        />
        <span
