<file path="frontend/src/components/Sidebar.jsx">
import React, { useState, useRef } from 'react';
import {
  Search,
  Users,
  UserPlus,
  LogOut,
  Sun,
  Moon,
  MessageSquarePlus,
  UserCheck,
  Clock,
  MessageSquare,
  SearchX
} from 'lucide-react';
import { formatSidebarTime } from '../utils/formatTime';
import { SidebarSkeleton } from './Skeletons';
import DispatchLogo from './DispatchLogo';

export default function Sidebar({
  currentUser,
  conversations,
  activeConvId,
  onSelectConversation,
  searchQuery,
  onSearchChange,
  searchResults,
  onSelectUserToChat,
  onSendFriendRequest,
  onOpenFriendsModal,
  onOpenProfileModal,
  onOpenCreateGroupModal,
  isDarkMode,
  onToggleDarkMode,
  onLogout,
  presenceMap,
  isLoadingConversations,
  onGoHome
}) {
  // Quản lý độ rộng thanh bên có lưu vào localStorage
  const [sidebarWidth, setSidebarWidth] = useState(() => {
    const saved = localStorage.getItem('sidebar_width');
    return saved ? parseInt(saved, 10) : 280;
  });
  const isResizingRef = useRef(false);

  const startResizing = (e) => {
    e.preventDefault();
    isResizingRef.current = true;
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';

    const onMouseMove = (moveEvent) => {
      if (!isResizingRef.current) return;
      let nextWidth = moveEvent.clientX;
      if (nextWidth < 220) nextWidth = 220;
      if (nextWidth > 480) nextWidth = 480;
      setSidebarWidth(nextWidth);
      localStorage.setItem('sidebar_width', nextWidth);
    };

    const onMouseUp = () => {
      isResizingRef.current = false;
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
      window.removeEventListener('mousemove', onMouseMove);
