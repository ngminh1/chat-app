<file path="frontend/src/components/ForwardModal.jsx">
import React, { useState } from 'react';
import {
  X,
  Share2,
  Search,
  Check,
  Loader2,
  FileText,
  Send
} from 'lucide-react';

export default function ForwardModal({
  isOpen,
  onClose,
  messageToForward,
  conversations,
  onConfirmForward,
  isDarkMode
}) {
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedConvIds, setSelectedConvIds] = useState([]);
  const [isSending, setIsSending] = useState(false);

  if (!isOpen || !messageToForward) return null;

  const toggleSelectConv = (convId) => {
    setSelectedConvIds((prev) =>
      prev.includes(convId) ? prev.filter((id) => id !== convId) : [...prev, convId]
    );
  };

  const filteredConversations = conversations.filter((c) => {
    const title = c.title || c.otherUser?.displayName || '';
    return title.toLowerCase().includes(searchQuery.toLowerCase());
  });

  const handleSend = async () => {
    if (selectedConvIds.length === 0 || isSending) return;
    setIsSending(true);
    try {
      await onConfirmForward(messageToForward.id, selectedConvIds);
      setSelectedConvIds([]);
      onClose();
    } catch (err) {
      console.error("Lỗi chuyển tiếp:", err);
    } finally {
      setIsSending(false);
    }
  };

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 backdrop-blur-xs select-none"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className={`w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] animate-in zoom-in-95 duration-150 border ${
          isDarkMode ? 'bg-slate-900 border-slate-800 text-slate-100' : 'bg-white border-slate-200 text-slate-900'
        }`}
      >
        {/* Header */}
        <div className={`px-5 py-4 border-b flex items-center justify-between ${
          isDarkMode ? 'bg-slate-800/60 border-slate-800' : 'bg-slate-50/70 border-slate-200'
        }`}>
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-xl bg-[#0062FF]/10 text-[#0062FF] flex items-center justify-center">
              <Share2 className="w-4 h-4" />
            </div>
            <div>
              <h2 className="text-sm font-bold">Chuyển tiếp tin nhắn</h2>
              <p className="text-[11px] text-slate-400">Gửi tin nhắn này đến các cuộc trò chuyện khác</p>
            </div>
          </div>
          <button onClick={onClose} className="p-1.5 rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 cursor-pointer">
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Message Preview Box */}
        <div className="p-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/60">
          <div className={`p-3 rounded-xl border text-xs ${
            isDarkMode ? 'bg-slate-800 border-slate-700 text-slate-200' : 'bg-white border-slate-200 text-slate-700 shadow-xs'
          }`}>
            <span className="font-bold text-[#0062FF] block mb-1">
              Tin nhắn từ {messageToForward.senderName}:
            </span>
            {messageToForward.messageType === 'IMAGE' ? (
              <div className="flex items-center gap-2">
                <img src={messageToForward.mediaUrl} alt="" className="w-12 h-12 rounded-lg object-cover border border-slate-300 dark:border-slate-700" />
                <span className="truncate">{messageToForward.content || '[Hình ảnh]'}</span>
              </div>
            ) : messageToForward.messageType === 'FILE' ? (
              <div className="flex items-center gap-2">
                <FileText className="w-4 h-4 text-[#0062FF]" />
                <span className="truncate font-medium">{messageToForward.fileName}</span>
              </div>
            ) : (
              <p className="whitespace-pre-wrap leading-relaxed">{messageToForward.content}</p>
            )}
          </div>
        </div>

        {/* Search */}
        <div className="px-4 pt-3 pb-1">
          <div className="relative">
            <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              placeholder="Tìm cuộc trò chuyện..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className={`w-full pl-8 pr-3 py-1.5 rounded-xl text-xs border focus:outline-none focus:border-[#0062FF] transition-all ${
                isDarkMode ? 'bg-slate-800 border-slate-700 text-white' : 'bg-slate-100 border-slate-200 text-slate-900'
              }`}
            />
          </div>
        </div>

        {/* Conversation List */}
        <div className="flex-1 overflow-y-auto p-4 divide-y divide-slate-100 dark:divide-slate-800/60">
          {filteredConversations.length === 0 ? (
            <p className="text-center py-8 text-xs text-slate-400">Không tìm thấy cuộc trò chuyện</p>
          ) : (
            filteredConversations.map((c) => {
              const isSelected = selectedConvIds.includes(c.conversationId);
              const title = c.title || c.otherUser?.displayName || 'Cuộc trò chuyện';
              const avatar = c.avatarUrl || c.otherUser?.avatarUrl;
              const isGroup = c.type === 'GROUP';

              return (
                <div
                  key={c.conversationId}
                  onClick={() => toggleSelectConv(c.conversationId)}
                  className={`p-2 flex items-center justify-between rounded-xl cursor-pointer transition-colors ${
                    isSelected ? 'bg-blue-50/80 dark:bg-blue-950/40' : 'hover:bg-slate-100/70 dark:hover:bg-slate-800/60'
                  }`}
                >
                  <div className="flex items-center gap-2.5 min-w-0">
                    {avatar ? (
                      <img src={avatar} alt="" className="w-8 h-8 rounded-full object-cover border border-slate-200 dark:border-slate-700" />
                    ) : (
                      <div className={`w-8 h-8 rounded-full text-white flex items-center justify-center font-bold text-xs shadow-xs ${
                        isGroup ? 'bg-purple-600' : 'bg-gradient-to-tr from-[#0062FF] to-sky-400'
                      }`}>
                        {title.charAt(0).toUpperCase()}
                      </div>
                    )}
                    <span className="text-xs font-semibold truncate">{title}</span>
                  </div>

                  <div className={`w-4 h-4 rounded-md border flex items-center justify-center transition-all ${
                    isSelected ? 'bg-[#0062FF] border-[#0062FF] text-white shadow-xs' : 'border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800'
                  }`}>
                    {isSelected && <Check className="w-3 h-3 stroke-[3]" />}
                  </div>
                </div>
              );
            })
          )}
        </div>

        {/* Footer Actions */}
        <div className={`p-4 border-t flex items-center justify-between gap-3 ${
          isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50/60 border-slate-200'
        }`}>
          <span className="text-xs font-medium text-slate-400">
            Đã chọn: <b className="text-[#0062FF]">{selectedConvIds.length}</b>
          </span>

          <div className="flex items-center gap-2">
            <button
              onClick={onClose}
              className="px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
            >
              Hủy
            </button>
            <button
              onClick={handleSend}
              disabled={selectedConvIds.length === 0 || isSending}
              className="px-3 py-1.5 text-xs font-semibold text-white rounded-xl bg-[#0062FF] hover:bg-[#0052D9] shadow-xs disabled:opacity-50 transition-all flex items-center gap-1.5 cursor-pointer"
            >
              {isSending ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Send className="w-3.5 h-3.5" />}
              Gửi chuyển tiếp
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/FriendsModal.jsx">
import React, { useState, useEffect } from 'react';
import axios from 'axios';
import {
  X,
  Users,
  UserCheck,
  Clock,
  MessageSquare,
  Check,
  UserMinus,
  Loader2,
  Inbox
} from 'lucide-react';
import { API_BASE } from '../config/api';

export default function FriendsModal({
  isOpen,
  onClose,
  currentUserId,
  onStartChatWithUser,
  isDarkMode
}) {
  const [activeTab, setActiveTab] = useState('friends');
  const [friendsList, setFriendsList] = useState([]);
  const [pendingList, setPendingList] = useState([]);
  const [loading, setLoading] = useState(false);
  const [actionLoadingId, setActionLoadingId] = useState(null);

  const fetchFriendsAndRequests = async () => {
    if (!currentUserId) return;
    setLoading(true);
    try {
      const [friendsRes, pendingRes] = await Promise.all([
        axios.get(`${API_BASE}/friends/${currentUserId}`),
        axios.get(`${API_BASE}/friends/pending/${currentUserId}`)
      ]);
      setFriendsList(friendsRes.data || []);
      setPendingList(pendingRes.data || []);
    } catch (err) {
      console.error("Lỗi lấy danh sách bạn bè / lời mời:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (isOpen) {
      fetchFriendsAndRequests();
    }
  }, [isOpen, currentUserId]);

  if (!isOpen) return null;

  const handleAcceptRequest = async (friendshipId) => {
    setActionLoadingId(friendshipId);
    try {
      await axios.put(`${API_BASE}/friends/${friendshipId}/accept`);
      await fetchFriendsAndRequests();
    } catch (err) {
      alert("Lỗi khi chấp nhận lời mời");
    } finally {
      setActionLoadingId(null);
    }
  };

  const handleDeclineRequest = async (friendshipId) => {
    setActionLoadingId(friendshipId);
    try {
      await axios.put(`${API_BASE}/friends/${friendshipId}/decline`);
      await fetchFriendsAndRequests();
    } catch (err) {
      alert("Lỗi khi từ chối lời mời");
    } finally {
      setActionLoadingId(null);
    }
  };

  const handleUnfriend = async (friendshipId, targetName) => {
    if (!window.confirm(`Bạn có chắc chắn muốn hủy kết bạn với "${targetName}"?`)) return;
    setActionLoadingId(friendshipId);
    try {
      await axios.delete(`${API_BASE}/friends/${friendshipId}`);
      await fetchFriendsAndRequests();
    } catch (err) {
      alert("Lỗi khi hủy kết bạn");
    } finally {
      setActionLoadingId(null);
    }
  };

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-xs select-none"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className={`w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] animate-in zoom-in-95 duration-150 border ${
          isDarkMode ? 'bg-slate-900 border-slate-800 text-slate-100' : 'bg-white border-slate-200 text-slate-900'
        }`}
      >
        {/* Header Modal */}
        <div className={`px-5 py-4 border-b flex items-center justify-between ${
          isDarkMode ? 'bg-slate-800/50 border-slate-800' : 'bg-slate-50/50 border-slate-200'
        }`}>
          <h2 className="text-sm font-bold flex items-center gap-2">
            <Users className="w-4 h-4 text-[#0062FF]" />
            Danh bạ bạn bè & Lời mời
          </h2>
          <button onClick={onClose} className="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* 2 Tabs: Bạn bè & Lời mời */}
        <div className={`flex border-b px-5 pt-2 gap-4 ${isDarkMode ? 'border-slate-800 bg-slate-900' : 'border-slate-200 bg-white'}`}>
          <button
            onClick={() => setActiveTab('friends')}
            className={`pb-2.5 text-xs font-bold flex items-center gap-1.5 border-b-2 transition-all cursor-pointer ${
              activeTab === 'friends'
                ? 'border-[#0062FF] text-[#0062FF]'
                : 'border-transparent text-slate-400 hover:text-slate-600 dark:hover:text-slate-200'
            }`}
          >
            <UserCheck className="w-4 h-4" />
            Bạn bè ({friendsList.length})
          </button>

          <button
            onClick={() => setActiveTab('pending')}
            className={`pb-2.5 text-xs font-bold flex items-center gap-1.5 border-b-2 transition-all cursor-pointer relative ${
              activeTab === 'pending'
                ? 'border-[#0062FF] text-[#0062FF]'
                : 'border-transparent text-slate-400 hover:text-slate-600 dark:hover:text-slate-200'
            }`}
          >
            <Inbox className="w-4 h-4" />
            Lời mời kết bạn
            {pendingList.length > 0 && (
              <span className="ml-1 px-1.5 py-0.2 bg-rose-500 text-white rounded-full text-[10px] font-bold">
                {pendingList.length}
              </span>
            )}
          </button>
        </div>

        {/* Nội dung danh sách */}
        <div className="flex-1 overflow-y-auto p-4 space-y-2">
          {loading ? (
            <div className="text-center py-12 text-xs text-slate-400">
              <Loader2 className="w-5 h-5 animate-spin text-[#0062FF] mx-auto mb-2" />
              Đang tải danh sách...
            </div>
          ) : activeTab === 'friends' ? (
            friendsList.length === 0 ? (
              <div className="text-center py-12 text-xs text-slate-400">
                <Users className="w-10 h-10 mx-auto mb-2 opacity-30" />
                Bạn chưa có bạn bè nào. Hãy dùng thanh tìm kiếm để kết bạn!
              </div>
            ) : (
              friendsList.map((item) => (
                <div
                  key={item.id}
                  className={`p-2.5 rounded-xl border flex items-center justify-between gap-2 transition-colors ${
                    isDarkMode ? 'bg-slate-800/40 border-slate-800 hover:bg-slate-800/80' : 'bg-slate-50 border-slate-100 hover:bg-slate-100/80'
                  }`}
                >
                  <div className="flex items-center gap-2.5 min-w-0 flex-1">
                    {item.user.avatarUrl ? (
                      <img src={item.user.avatarUrl} alt="" className="w-8 h-8 rounded-full object-cover flex-shrink-0" />
                    ) : (
                      <div className="w-8 h-8 rounded-full bg-gradient-to-tr from-[#0062FF] to-sky-400 text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
                        {item.user.displayName.charAt(0).toUpperCase()}
                      </div>
                    )}
                    <div className="truncate">
                      <p className="text-xs font-semibold truncate leading-tight">{item.user.displayName}</p>
                      <p className="text-[10px] text-slate-400 truncate">@{item.user.username}</p>
                    </div>
                  </div>

                  <div className="flex items-center gap-1 flex-shrink-0">
                    <button
                      onClick={() => {
                        onClose();
                        onStartChatWithUser(item.user);
                      }}
                      className="p-2 bg-[#0062FF] hover:bg-[#0052D9] text-white rounded-lg transition-colors cursor-pointer"
                      title="Nhắn tin ngay"
                    >
                      <MessageSquare className="w-3.5 h-3.5" />
                    </button>
                    <button
                      onClick={() => handleUnfriend(item.id, item.user.displayName)}
                      disabled={actionLoadingId === item.id}
                      className="p-2 text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-colors cursor-pointer"
                      title="Hủy kết bạn"
                    >
                      <UserMinus className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              ))
            )
          ) : (
            pendingList.length === 0 ? (
              <div className="text-center py-12 text-xs text-slate-400">
                <Clock className="w-10 h-10 mx-auto mb-2 opacity-30" />
                Không có lời mời kết bạn nào đang chờ
              </div>
            ) : (
              pendingList.map((item) => (
                <div
                  key={item.id}
                  className={`p-2.5 rounded-xl border flex items-center justify-between gap-2 transition-colors ${
                    isDarkMode ? 'bg-slate-800/40 border-slate-800' : 'bg-slate-50 border-slate-100'
                  }`}
                >
                  <div className="flex items-center gap-2.5 min-w-0 flex-1">
                    {item.user.avatarUrl ? (
                      <img src={item.user.avatarUrl} alt="" className="w-8 h-8 rounded-full object-cover flex-shrink-0" />
                    ) : (
                      <div className="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
                        {item.user.displayName.charAt(0).toUpperCase()}
                      </div>
                    )}
                    <div className="truncate">
                      <p className="text-xs font-semibold truncate leading-tight">{item.user.displayName}</p>
                      <p className="text-[10px] text-slate-400 truncate">@{item.user.username} đã gửi lời mời</p>
                    </div>
                  </div>

                  <div className="flex items-center gap-1.5 flex-shrink-0">
                    <button
                      onClick={() => handleAcceptRequest(item.id)}
                      disabled={actionLoadingId === item.id}
                      className="px-3 py-1.5 bg-[#0062FF] hover:bg-[#0052D9] text-white text-xs font-semibold rounded-lg flex items-center gap-1 shadow-xs transition-colors cursor-pointer"
                    >
                      <Check className="w-3.5 h-3.5" /> Đồng ý
                    </button>
                    <button
                      onClick={() => handleDeclineRequest(item.id)}
                      disabled={actionLoadingId === item.id}
                      className="px-2.5 py-1.5 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg transition-colors cursor-pointer"
                    >
                      Từ chối
                    </button>
                  </div>
                </div>
              ))
            )
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/GroupDetailModal.jsx">
import React, { useState, useEffect } from 'react';
import axios from 'axios';
import {
  X,
  Users,
  UserPlus,
  LogOut,
  Trash2,
  Shield,
  Edit2,
  Check,
  Loader2,
  Search,
  Palette,
  FolderOpen
} from 'lucide-react';
import { CHAT_THEMES } from '../utils/themeConfig';
import { API_BASE } from '../config/api';

export default function GroupDetailModal({
  isOpen,
  onClose,
  conversation,
  currentUserId,
  onGroupUpdated,
  onLeftGroup,
  onOpenMediaGallery,
  isDarkMode
}) {
  const [members, setMembers] = useState([]);
  const [friends, setFriends] = useState([]);
  const [isEditingTitle, setIsEditingTitle] = useState(false);
  const [newTitle, setNewTitle] = useState('');
  const [isAddingMember, setIsAddingMember] = useState(false);
  const [friendSearch, setFriendSearch] = useState('');
  const [loading, setLoading] = useState(false);
  const [actionLoading, setActionLoading] = useState(false);
  const [selectedTheme, setSelectedTheme] = useState('blue');

  const isGroup = conversation?.type === 'GROUP';
  const targetAvatarUrl = conversation?.avatarUrl || conversation?.otherUser?.avatarUrl;
  const targetTitle = conversation?.title || conversation?.otherUser?.displayName || 'U';

  const fetchMembers = async () => {
    if (!conversation) return;
    setLoading(true);
    try {
      const res = await axios.get(`${API_BASE}/chat/conversations/${conversation.conversationId}/members`);
      setMembers(res.data);
    } catch (err) {
      console.error("Lỗi lấy danh sách thành viên:", err);
    } finally {
      setLoading(false);
    }
  };

  const fetchFriends = async () => {
    try {
      const res = await axios.get(`${API_BASE}/friends/${currentUserId}`);
      setFriends(res.data);
    } catch (err) {
      console.error("Lỗi lấy danh sách bạn bè:", err);
    }
  };

  useEffect(() => {
    if (isOpen && conversation) {
      setNewTitle(conversation.title || '');
      setSelectedTheme(conversation.theme || 'blue');
      setIsEditingTitle(false);
      setIsAddingMember(false);
      setFriendSearch('');
      if (isGroup) {
        fetchMembers();
        fetchFriends();
      }
    }
  }, [isOpen, conversation]);

  if (!isOpen || !conversation) return null;

  const currentMemberObj = members.find((m) => m.userId === currentUserId);
  const isAdmin = currentMemberObj?.role === 'ADMIN';

  const handleChangeTheme = async (themeKey) => {
    setSelectedTheme(themeKey);
    onGroupUpdated({ ...conversation, theme: themeKey });

    try {
      const res = await axios.put(
        `${API_BASE}/chat/conversations/${conversation.conversationId}/theme`,
        null,
        { params: { theme: themeKey } }
      );
      onGroupUpdated(res.data);
    } catch (err) {
      console.error("Lỗi đổi theme:", err);
    }
  };

  const handleUpdateTitle = async () => {
    if (!newTitle.trim()) return;
    setActionLoading(true);
    try {
      const res = await axios.put(
        `${API_BASE}/chat/conversations/${conversation.conversationId}/group-info`,
        { title: newTitle.trim() },
        { params: { currentUserId } }
      );
      setIsEditingTitle(false);
      onGroupUpdated(res.data);
    } catch (err) {
      console.error("Lỗi đổi tên nhóm:", err);
    } finally {
      setActionLoading(false);
    }
  };

  const handleAddMember = async (targetUserId) => {
    setActionLoading(true);
    try {
      await axios.post(
        `${API_BASE}/chat/conversations/${conversation.conversationId}/members`,
        null,
        { params: { currentUserId, targetUserId } }
      );
      await fetchMembers();
      setIsAddingMember(false);
    } catch (err) {
      alert(err.response?.data?.message || "Không thể thêm thành viên");
    } finally {
      setActionLoading(false);
    }
  };

  const handleRemoveMember = async (targetUserId, targetName) => {
    if (!window.confirm(`Bạn có chắc chắn muốn xóa "${targetName}" khỏi nhóm?`)) return;
    setActionLoading(true);
    try {
      await axios.delete(
        `${API_BASE}/chat/conversations/${conversation.conversationId}/members/${targetUserId}`,
        { params: { currentUserId } }
      );
      await fetchMembers();
    } catch (err) {
      alert(err.response?.data?.message || "Không thể xóa thành viên");
    } finally {
      setActionLoading(false);
    }
  };

  const handleLeaveGroup = async () => {
    if (!window.confirm("Bạn có chắc chắn muốn rời khỏi nhóm này?")) return;
    setActionLoading(true);
    try {
      await axios.post(
        `${API_BASE}/chat/conversations/${conversation.conversationId}/leave`,
        null,
        { params: { userId: currentUserId } }
      );
      onLeftGroup(conversation.conversationId);
      onClose();
    } catch (err) {
      console.error("Lỗi rời nhóm:", err);
    } finally {
      setActionLoading(false);
    }
  };

  const availableFriendsToAdd = friends.filter(
    (f) =>
      !members.some((m) => m.userId === f.user.id) &&
      (f.user.displayName.toLowerCase().includes(friendSearch.toLowerCase()) ||
        f.user.username.toLowerCase().includes(friendSearch.toLowerCase()))
  );

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-xs select-none"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className={`w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] animate-in zoom-in-95 duration-150 border ${
          isDarkMode ? 'bg-slate-900 border-slate-800 text-slate-100' : 'bg-white border-slate-200 text-slate-900'
        }`}
      >
        {/* Header */}
        <div className={`px-5 py-4 border-b flex items-center justify-between ${
          isDarkMode ? 'bg-slate-800/50 border-slate-800' : 'bg-slate-50/50 border-slate-200'
        }`}>
          <h2 className="text-sm font-bold flex items-center gap-2">
            <Users className="w-4 h-4 text-[#0062FF]" />
            {isGroup ? 'Thông tin nhóm' : 'Thông tin cuộc trò chuyện'}
          </h2>
          <button onClick={onClose} className="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
            <X className="w-4 h-4" />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-5 space-y-5">
          {/* Avatar & Tên hội thoại */}
          <div className="flex flex-col items-center text-center">
            {targetAvatarUrl ? (
              <img
                src={targetAvatarUrl}
                alt=""
                className="w-16 h-16 rounded-full object-cover border border-slate-200 dark:border-slate-700 shadow-xs mb-2.5 flex-shrink-0"
              />
            ) : (
              <div className={`w-16 h-16 rounded-full text-white flex items-center justify-center font-bold text-xl shadow-xs mb-2.5 flex-shrink-0 ${
                isGroup ? 'bg-gradient-to-tr from-purple-600 to-indigo-500' : 'bg-gradient-to-tr from-[#0062FF] to-sky-400'
              }`}>
                {targetTitle.charAt(0).toUpperCase()}
              </div>
            )}

            {isGroup ? (
              isEditingTitle ? (
                <div className="flex items-center gap-2 w-full max-w-xs">
                  <input
                    type="text"
                    value={newTitle}
                    onChange={(e) => setNewTitle(e.target.value)}
                    className="flex-1 px-3 py-1.5 text-xs font-semibold border rounded-lg focus:outline-none dark:bg-slate-800 dark:border-slate-700"
                    autoFocus
                  />
                  <button onClick={handleUpdateTitle} disabled={actionLoading} className="p-1.5 bg-[#0062FF] text-white rounded-lg cursor-pointer">
                    <Check className="w-4 h-4" />
                  </button>
                  <button onClick={() => setIsEditingTitle(false)} className="p-1.5 bg-slate-100 dark:bg-slate-800 rounded-lg cursor-pointer">
                    <X className="w-4 h-4" />
                  </button>
                </div>
              ) : (
                <div className="flex items-center gap-2">
                  <h3 className="text-base font-bold">{conversation.title}</h3>
                  <button onClick={() => setIsEditingTitle(true)} className="p-1 text-slate-400 hover:text-[#0062FF] cursor-pointer">
                    <Edit2 className="w-3.5 h-3.5" />
                  </button>
                </div>
              )
            ) : (
              <div>
                <h3 className="text-base font-bold">{conversation.otherUser?.displayName}</h3>
                <p className="text-xs text-slate-400 mt-0.5">@{conversation.otherUser?.username}</p>
              </div>
            )}
          </div>

          {/* Nút vào kho Media */}
          <button
            onClick={() => {
              onClose();
              onOpenMediaGallery();
            }}
            className={`w-full py-2.5 px-4 rounded-xl border flex items-center justify-between text-xs font-semibold transition-colors cursor-pointer ${
              isDarkMode ? 'bg-slate-800/60 border-slate-700 hover:bg-slate-800 text-slate-200' : 'bg-slate-50 border-slate-200 hover:bg-slate-100 text-slate-700'
            }`}
          >
            <span className="flex items-center gap-2">
              <FolderOpen className="w-4 h-4 text-[#0062FF]" />
              Kho lưu trữ hình ảnh & tệp đính kèm
            </span>
            <span className="text-[#0062FF]">Xem tất cả →</span>
          </button>

          {/* Đổi màu chủ đề */}
          <div className="space-y-2">
            <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
              <Palette className="w-3.5 h-3.5" /> Chủ đề cuộc trò chuyện (Theme)
            </h4>
            <div className="grid grid-cols-5 gap-2 pt-1">
              {Object.values(CHAT_THEMES).map((theme) => {
                const isSelected = selectedTheme === theme.id;
                return (
                  <button
                    key={theme.id}
                    type="button"
                    onClick={() => handleChangeTheme(theme.id)}
                    className={`flex flex-col items-center gap-1.5 p-2 rounded-xl transition-all cursor-pointer border ${
                      isSelected
                        ? 'border-[#0062FF] bg-blue-50/40 dark:bg-blue-950/40 ring-2 ring-[#0062FF] shadow-xs'
                        : 'border-transparent hover:bg-slate-100 dark:hover:bg-slate-800'
                    }`}
                  >
                    <span
                      className="w-8 h-8 rounded-full shadow-xs transition-transform hover:scale-110 flex items-center justify-center text-white"
                      style={{ backgroundColor: theme.colorCode }}
                    >
                      {isSelected && <Check className="w-4 h-4 stroke-[3]" />}
                    </span>
                    <span className="text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate w-full text-center">
                      {theme.name.split(' ')[0]}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Quản lý thành viên nếu là nhóm */}
          {isGroup && (
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider">
                  Thành viên ({members.length})
                </h4>
                <button
                  onClick={() => setIsAddingMember(!isAddingMember)}
                  className="text-xs font-semibold text-[#0062FF] flex items-center gap-1 hover:underline cursor-pointer"
                >
                  <UserPlus className="w-3.5 h-3.5" /> Thêm thành viên
                </button>
              </div>

              {isAddingMember && (
                <div className={`p-3 border rounded-xl space-y-2 ${
                  isDarkMode ? 'bg-slate-800/60 border-slate-700' : 'bg-blue-50/50 border-blue-100'
                }`}>
                  <div className="relative">
                    <Search className="w-3 h-3 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" />
                    <input
                      type="text"
                      placeholder="Tìm bạn bè..."
                      value={friendSearch}
                      onChange={(e) => setFriendSearch(e.target.value)}
                      className={`w-full pl-7 pr-3 py-1.5 rounded-lg text-xs focus:outline-none ${
                        isDarkMode ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'
                      }`}
                    />
                  </div>

                  <div className={`max-h-36 overflow-y-auto divide-y rounded-lg border p-1 ${
                    isDarkMode ? 'bg-slate-900 border-slate-800 divide-slate-800' : 'bg-white border-slate-100 divide-slate-100'
                  }`}>
                    {availableFriendsToAdd.length === 0 ? (
                      <p className="text-center py-4 text-[11px] text-slate-400">Không có bạn bè khả dụng</p>
                    ) : (
                      availableFriendsToAdd.map((f) => (
                        <div key={f.id} className="p-2 flex items-center justify-between">
                          <div className="truncate pr-2">
                            <p className="text-xs font-semibold truncate">{f.user.displayName}</p>
                            <p className="text-[10px] text-slate-400">@{f.user.username}</p>
                          </div>
                          <button
                            onClick={() => handleAddMember(f.user.id)}
                            disabled={actionLoading}
                            className="px-2.5 py-1 bg-[#0062FF] text-white text-[11px] font-semibold rounded-lg cursor-pointer"
                          >
                            Thêm
                          </button>
                        </div>
                      ))
                    )}
                  </div>
                </div>
              )}

              <div className={`divide-y border rounded-xl p-1 ${
                isDarkMode ? 'border-slate-800 divide-slate-800 bg-slate-900/50' : 'border-slate-100 divide-slate-100 bg-slate-50/30'
              }`}>
                {loading ? (
                  <div className="text-center py-6 text-xs text-slate-400">
                    <Loader2 className="w-4 h-4 animate-spin text-[#0062FF] mx-auto mb-1" />
                    Đang tải danh sách...
                  </div>
                ) : (
                  members.map((m) => (
                    <div key={m.userId} className="p-2.5 flex items-center justify-between rounded-lg">
                      <div className="flex items-center gap-2.5 min-w-0">
                        {m.avatarUrl ? (
                          <img src={m.avatarUrl} alt="" className="w-8 h-8 rounded-full object-cover flex-shrink-0" />
                        ) : (
                          <div className="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center font-bold text-xs flex-shrink-0">
                            {m.displayName.charAt(0).toUpperCase()}
                          </div>
                        )}
                        <div className="truncate">
                          <div className="flex items-center gap-1.5">
                            <span className="text-xs font-semibold truncate">{m.displayName}</span>
                            {m.role === 'ADMIN' && (
                              <span className="px-1.5 py-0.5 bg-blue-100 text-[#0062FF] text-[9px] font-bold rounded flex items-center gap-0.5">
                                <Shield className="w-2.5 h-2.5" /> Quản trị viên
                              </span>
                            )}
                          </div>
                          <span className="text-[11px] text-slate-400">@{m.username}</span>
                        </div>
                      </div>

                      {isAdmin && m.userId !== currentUserId && (
                        <button
                          onClick={() => handleRemoveMember(m.userId, m.displayName)}
                          disabled={actionLoading}
                          className="p-1.5 text-slate-400 hover:text-rose-500 rounded-lg cursor-pointer"
                          title="Xóa khỏi nhóm"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      )}
                    </div>
                  ))
                )}
              </div>
            </div>
          )}

          {isGroup && (
            <div className="pt-2">
              <button
                onClick={handleLeaveGroup}
                disabled={actionLoading}
                className="w-full py-2.5 text-rose-600 bg-rose-500/10 hover:bg-rose-500/20 font-semibold text-xs rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer"
              >
                <LogOut className="w-4 h-4" /> Rời khỏi nhóm
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/MediaGalleryModal.jsx">
import React, { useState, useEffect } from 'react';
import axios from 'axios';
import {
  X,
  Image as ImageIcon,
  FileText,
  Download,
  Loader2,
  Calendar,
  Eye,
  FolderOpen
} from 'lucide-react';
import { formatSidebarTime } from '../utils/formatTime';
import { API_BASE } from '../config/api';

export default function MediaGalleryModal({
  isOpen,
  onClose,
  conversationId,
  conversationTitle,
  onJumpToMessage,
  isDarkMode
}) {
  const [activeTab, setActiveTab] = useState('images');
  const [mediaList, setMediaList] = useState([]);
  const [loading, setLoading] = useState(false);
  const [previewImg, setPreviewImg] = useState(null);

  useEffect(() => {
    if (isOpen && conversationId) {
      setLoading(true);
      axios.get(`${API_BASE}/chat/conversations/${conversationId}/media`)
        .then((res) => setMediaList(res.data))
        .catch((err) => console.error("Lỗi lấy media:", err))
        .finally(() => setLoading(false));
    }
  }, [isOpen, conversationId]);

  if (!isOpen) return null;

  const images = mediaList.filter((m) => m.messageType === 'IMAGE');
  const files = mediaList.filter((m) => m.messageType === 'FILE');

  const formatFileSize = (bytes) => {
    if (!bytes) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  };

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 backdrop-blur-xs select-none"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className={`w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] animate-in zoom-in-95 duration-150 border ${
          isDarkMode ? 'bg-slate-900 border-slate-800 text-slate-100' : 'bg-white border-slate-200 text-slate-900'
        }`}
      >
        {/* Header */}
        <div className={`px-5 py-4 border-b flex items-center justify-between ${
          isDarkMode ? 'bg-slate-800/60 border-slate-800' : 'bg-slate-50/70 border-slate-200'
        }`}>
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-xl bg-[#0062FF]/10 text-[#0062FF] flex items-center justify-center">
              <FolderOpen className="w-4 h-4" />
            </div>
            <div>
              <h2 className="text-sm font-bold">Kho lưu trữ Media & Tệp</h2>
              <p className="text-xs text-slate-400 truncate max-w-xs">{conversationTitle}</p>
            </div>
          </div>
          <button onClick={onClose} className="p-1.5 rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 cursor-pointer">
            <X className="w-4 h-4" />
